# Public canonical site URL, set to the real domain before deployment.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3010
# Optional HTTPS endpoint that durably accepts enquiries. Kept server-side.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
# Alternative for a persistent Node server: mount this folder on a durable volume.
LEAD_STORAGE_DIR=.data
